<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_link"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="com.marky.app.marky.action.OPEN_ROUTE"
            android:targetPackage="com.marky.app.marky"
            android:targetClass="com.marky.app.marky.MainActivity">
            <extra android:name="route" android:value="/add" />
        </intent>
    </shortcut>
